# ============================
# 🏴‍☠️ P.I.R.A.T.E. Media Server
# Environment Variables
# ============================

# General Settings
TZ=America/New_York                 # Timezone for all services
ADMIN_EMAIL=admin@example.com       # Administrator email for notifications

# Media Paths
MEDIA_PATH=/mnt/media               # Main path for media files (e.g., TV shows, movies, music)

# Port Configurations
PORTAINER_PORT=9000                 # Port for Portainer (Docker management)
PLEX_PORT=32400                     # Port for Plex Media Server
JELLYFIN_PORT=8096                  # Port for Jellyfin Media Server

# Docker Network Settings
DOCKER_NETWORK=pirate_network       # Custom Docker network for media server services

# Git Repository (Optional)
GIT_REPO=https://github.com/yourusername/pirate-media-server.git  # Repository URL for updates and contributions

# VPN Settings (Optional)
VPN_ENABLED=false                   # Enable or disable VPN (true/false)
VPN_PROVIDER=wireguard              # VPN provider (e.g., wireguard, openvpn)

# Subtitle Configuration
SUBTITLE_LANGUAGE=en                # Preferred subtitle language (ISO 639-1 code)

# Automatic Updates
AUTO_UPDATE=true                    # Enable automatic updates for Docker containers and packages
